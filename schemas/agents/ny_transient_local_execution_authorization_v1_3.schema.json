    "seventh_transient_pii_approval_ref": {
      "type": "string",
      "minLength": 1
    },
    "seventh_fresh_preflight_receipt_ref": {
      "type": "string",
      "minLength": 1
    },
    "seventh_execution_authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "local_file_approval_granted": {
      "const": true
    },
    "transient_pii_approval_granted": {
      "const": true
    },
    "fresh_preflight_exact_match": {
      "const": true
    },
    "execution_authorization_granted": {
      "const": true
    },
    "proposal_checkpoint": {
      "const": "18c270bd89d7c4e0c37a5bc046a1f09e49dc672e"
    },
    "runner_checkpoint": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_local_filename": {
      "const": "FINDERS.zip"
