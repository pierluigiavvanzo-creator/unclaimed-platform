    "download_mode": {
      "const": "MANUAL_TO_DEDICATED_OS_TEMP"
    },
    "downloads_max": {
      "const": 1
    },
    "retries_max": {
      "const": 0
    },
    "direct_network_client_allowed": {
      "const": false
    }
