{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unclaimed-platform:schema:a01-acquisition-request:1.0.0",
  "title": "A01AcquisitionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "source_id", "jurisdiction", "mode", "requested_at", "acquisition_scope", "max_bytes", "approval_id", "expected_media_types"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "jurisdiction": {"const": "CA"},
    "mode": {"type": "string", "enum": ["MOCK", "REAL"]},
    "requested_at": {"type": "string", "format": "date-time"},
    "acquisition_scope": {"const": "RAW_INGEST_ONLY"},
    "max_bytes": {"type": "integer", "minimum": 1},
    "approval_id": {"type": ["string", "null"]},
    "expected_media_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [{"if": {"properties": {"mode": {"const": "REAL"}}, "required": ["mode"]}, "then": {"properties": {"approval_id": {"type": "string", "minLength": 1}}}}]
}
