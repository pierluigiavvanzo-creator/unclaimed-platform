{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unclaimed-platform:schema:ny-transient-local-execution-authorization:1.2.0",
  "title": "NY OSC Transient Local File Execution Authorization v1.2 Synthetic RAW-Literal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "mode",
    "attempt_number",
    "local_file_approval_ref",
    "gate2_approval_ref",
    "local_file_approval_granted",
    "gate2_approval_granted",
    "expected_local_filename",
    "max_download_bytes",
    "max_uncompressed_bytes",
    "max_archive_members",
    "delete_local_file_immediately",
    "durable_raw_persistence_allowed",
    "repository_persistence_allowed",
    "cloud_sync_allowed",
    "owner_field_logging_allowed",
    "row_specific_human_inspection_allowed",
    "quote_dialect_mode"
  ],
  "properties": {
    "contract_version": {
      "const": "1.2.0"
    },
    "mode": {
      "const": "SYNTHETIC_TEST"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "local_file_approval_ref": {
      "type": "string",
      "minLength": 1
    },
    "gate2_approval_ref": {
      "type": "string",
      "minLength": 1
    },
    "local_file_approval_granted": {
      "const": true
    },
    "gate2_approval_granted": {
      "const": true
    },
    "expected_local_filename": {
      "const": "FINDERS.zip"
    },
    "max_download_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_uncompressed_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_archive_members": {
      "type": "integer",
      "minimum": 1
    },
    "delete_local_file_immediately": {
      "const": true
    },
    "durable_raw_persistence_allowed": {
      "const": false
    },
    "repository_persistence_allowed": {
      "const": false
    },
    "cloud_sync_allowed": {
      "const": false
    },
    "owner_field_logging_allowed": {
      "const": false
    },
    "row_specific_human_inspection_allowed": {
      "const": false
    },
    "quote_dialect_mode": {
      "const": "DOCUMENTED_WIDTH_RAW_LITERAL_POLICY"
    }
  }
}
