{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unclaimed-platform:schema:a01-raw-artifact-record:1.0.0",
  "title": "A01RawArtifactRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "storage_ref",
    "content_hash",
    "byte_count",
    "content_type",
    "source_id",
    "source_uri",
    "authority",
    "acquisition_method",
    "retrieved_at",
    "source_revision",
    "approval_reference",
    "terms_review_ref",
    "retention_policy_ref",
    "processing_purpose",
    "data_categories",
    "requested_fields",
    "provenance_metadata",
    "synthetic",
    "immutable"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "storage_ref": {"type": "string", "pattern": "^raw/sha256/[a-f0-9]{2}/[a-f0-9]{2}/[a-f0-9]{64}$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "byte_count": {"type": "integer", "minimum": 0},
    "content_type": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "source_uri": {"type": "string", "format": "uri"},
    "authority": {"type": "string", "minLength": 1},
    "acquisition_method": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
    "source_revision": {"type": ["string", "null"]},
    "approval_reference": {"type": ["string", "null"], "minLength": 1},
    "terms_review_ref": {"type": "string", "minLength": 1},
    "retention_policy_ref": {"type": "string", "minLength": 1},
    "processing_purpose": {"type": "string", "minLength": 1},
    "data_categories": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "requested_fields": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "provenance_metadata": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]}
    },
    "synthetic": {"type": "boolean"},
    "immutable": {"const": true}
  }
}
