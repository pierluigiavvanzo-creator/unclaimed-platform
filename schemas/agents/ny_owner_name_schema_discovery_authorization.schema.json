{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unclaimed-platform:schema:ny-owner-name-schema-discovery-authorization:1.0.0",
  "title": "NY Owner Name First Schema Discovery Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "mode",
    "source_id",
    "gate_id",
    "approval_id",
    "max_download_bytes",
    "max_uncompressed_bytes",
    "max_archive_members",
    "expected_archive_name",
    "expected_delimiter",
    "persist_raw_bytes",
    "persist_owner_rows",
    "owner_field_logging",
    "row_specific_human_inspection"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "SYNTHETIC_TEST",
        "AUTHORIZED_TRANSIENT_MEMORY_ONLY"
      ]
    },
    "source_id": {
      "const": "ny.osc.unclaimed_funds.owner_name_file"
    },
    "gate_id": {
      "const": "HUMAN_NY_OSC_OWNER_NAME_FILE_FIRST_DOWNLOAD_TRANSIENT_PII_AUTHORIZATION"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "max_download_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_uncompressed_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_archive_members": {
      "type": "integer",
      "minimum": 1
    },
    "expected_archive_name": {
      "const": "NYSFINDERS.ZIP"
    },
    "expected_delimiter": {
      "const": "|"
    },
    "persist_raw_bytes": {
      "const": false
    },
    "persist_owner_rows": {
      "const": false
    },
    "owner_field_logging": {
      "const": false
    },
    "row_specific_human_inspection": {
      "const": false
    }
  }
}
