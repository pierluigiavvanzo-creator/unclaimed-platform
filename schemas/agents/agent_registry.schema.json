{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unclaimed-platform:schema:agent-registry:1.0.0",
  "title": "AgentRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","agents"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "agents": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id","name","purpose","enabled","decision_required"],
        "properties": {
          "agent_id": {"type": "string", "pattern": "^A(?:0[0-9]|1[0-9]|2[0-3])$"},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "decision_required": {"type": "boolean"}
        }
      }
    }
  }
}
