{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agents/ny_owner_name_product_slice_result.schema.json",
  "title": "NY Owner Name Product Slice Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_id",
    "status",
    "total_records",
    "structurally_conforming_records",
    "deferred_structural_records",
    "authority_backed_insurance_records",
    "primary_in03_candidate_records",
    "other_insurance_records",
    "no_authority_backed_insurance_match_records",
    "property_type_unclassifiable_records",
    "candidate_outcome",
    "candidate_materialization_state",
    "recoverable_value_state",
    "source_amount_available",
    "fee_basis_state",
    "economic_actionability",
    "exact_authority_match_only",
    "structural_defer_policy",
    "owner_values_buffered",
    "owner_rows_persisted",
    "owner_field_logging",
    "row_specific_human_inspection",
    "no_raw_record_returned",
    "no_owner_values_returned"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "source_id": {"const": "ny.osc.unclaimed_funds.owner_name_file"},
    "status": {"const": "COMPLETED"},
    "total_records": {"type": "integer", "minimum": 0},
    "structurally_conforming_records": {"type": "integer", "minimum": 0},
    "deferred_structural_records": {"type": "integer", "minimum": 0},
    "authority_backed_insurance_records": {"type": "integer", "minimum": 0},
    "primary_in03_candidate_records": {"type": "integer", "minimum": 0},
    "other_insurance_records": {"type": "integer", "minimum": 0},
    "no_authority_backed_insurance_match_records": {"type": "integer", "minimum": 0},
    "property_type_unclassifiable_records": {"type": "integer", "minimum": 0},
    "candidate_outcome": {"enum": ["CANDIDATES_PRESENT_AGGREGATE_ONLY", "ZERO_CANDIDATE_DOCUMENTED"]},
    "candidate_materialization_state": {"enum": ["NOT_AUTHORIZED_AGGREGATE_ONLY", "NOT_APPLICABLE_ZERO_CANDIDATE"]},
    "recoverable_value_state": {"const": "UNKNOWN_FROM_SOURCE"},
    "source_amount_available": {"const": false},
    "fee_basis_state": {"const": "NOT_COMPUTABLE_FROM_SOURCE"},
    "economic_actionability": {"enum": ["VALUE_EVIDENCE_REQUIRED", "ZERO_CANDIDATE_NO_CASE_ECONOMICS"]},
    "exact_authority_match_only": {"const": true},
    "structural_defer_policy": {"const": "PIPE_COUNT_NOT_13_DEFER_METADATA_ONLY"},
    "owner_values_buffered": {"const": false},
    "owner_rows_persisted": {"const": false},
    "owner_field_logging": {"const": false},
    "row_specific_human_inspection": {"const": false},
    "no_raw_record_returned": {"const": true},
    "no_owner_values_returned": {"const": true}
  }
}
