{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unclaimed-platform.local/schemas/common/source_transport_preflight_execution.schema.json",
  "title": "SourceTransportPreflightExecution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "source_id",
    "jurisdiction",
    "execution_approval_ref",
    "official_source_page",
    "target_link_label",
    "controls",
    "endpoint_discovery",
    "transport",
    "safety_state",
    "result_status",
    "result_reason"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "execution_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 2},
    "execution_approval_ref": {"type": "string", "minLength": 1},
    "official_source_page": {"type": "string", "format": "uri", "pattern": "^https://"},
    "target_link_label": {"type": "string", "minLength": 1},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "https_only",
        "request_method",
        "timeout_seconds",
        "max_redirects",
        "allowlisted_hosts",
        "response_body_bytes_allowed",
        "persist_response_body",
        "parse_response_body",
        "persist_dataset_artifact",
        "pii_processing_allowed",
        "beneficiary_matching_allowed",
        "outreach_allowed"
      ],
      "properties": {
        "https_only": {"const": true},
        "request_method": {"const": "HEAD"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "max_redirects": {"type": "integer", "minimum": 0, "maximum": 5},
        "allowlisted_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "response_body_bytes_allowed": {"const": 0},
        "persist_response_body": {"const": false},
        "parse_response_body": {"const": false},
        "persist_dataset_artifact": {"const": false},
        "pii_processing_allowed": {"const": false},
        "beneficiary_matching_allowed": {"const": false},
        "outreach_allowed": {"const": false}
      }
    },
    "endpoint_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_page_request_performed",
        "extraction_method",
        "extracted_endpoint",
        "extracted_host"
      ],
      "properties": {
        "source_page_request_performed": {"type": "boolean"},
        "extraction_method": {"const": "OFFICIAL_SOURCE_PAGE_HTML_ANCHOR"},
        "extracted_endpoint": {
          "oneOf": [
            {"type": "string", "format": "uri", "pattern": "^https://"},
            {"type": "null"}
          ]
        },
        "extracted_host": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "download_endpoint_request_performed",
        "observed_at",
        "redirect_hops",
        "final_endpoint",
        "final_host",
        "http_status",
        "response_headers",
        "content_type",
        "content_length",
        "tls_scheme",
        "response_body_bytes_read"
      ],
      "properties": {
        "download_endpoint_request_performed": {"type": "boolean"},
        "observed_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "redirect_hops": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requested_endpoint", "http_status", "location"],
            "properties": {
              "requested_endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
              "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
              "location": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "null"}
                ]
              }
            }
          }
        },
        "final_endpoint": {
          "oneOf": [
            {"type": "string", "format": "uri", "pattern": "^https://"},
            {"type": "null"}
          ]
        },
        "final_host": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "http_status": {
          "oneOf": [
            {"type": "integer", "minimum": 100, "maximum": 599},
            {"type": "null"}
          ]
        },
        "response_headers": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "content_type": {
          "oneOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "content_length": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "tls_scheme": {
          "oneOf": [
            {"const": "https"},
            {"type": "null"}
          ]
        },
        "response_body_bytes_read": {"const": 0}
      }
    },
    "safety_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_performed",
        "source_approved",
        "source_enabled",
        "persist_response_body",
        "parse_response_body",
        "persist_dataset_artifact",
        "real_pii_processed",
        "beneficiary_matching_performed",
        "outreach_performed"
      ],
      "properties": {
        "acquisition_performed": {"const": false},
        "source_approved": {"const": false},
        "source_enabled": {"const": false},
        "persist_response_body": {"const": false},
        "parse_response_body": {"const": false},
        "persist_dataset_artifact": {"const": false},
        "real_pii_processed": {"const": false},
        "beneficiary_matching_performed": {"const": false},
        "outreach_performed": {"const": false}
      }
    },
    "result_status": {
      "enum": [
        "SUCCEEDED",
        "BLOCKED_REDIRECT_HOST",
        "BLOCKED_REDIRECT_LIMIT",
        "FAILED_ENDPOINT_DISCOVERY",
        "FAILED_TRANSPORT"
      ]
    },
    "result_reason": {"type": "string", "minLength": 1}
  }
}
