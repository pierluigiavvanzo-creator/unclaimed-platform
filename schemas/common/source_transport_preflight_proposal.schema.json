{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unclaimed-platform:schema:source-transport-preflight-proposal:1.0.0",
  "title": "SourceTransportPreflightProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "proposal_version",
    "source_id",
    "jurisdiction",
    "proposal_status",
    "created_at",
    "network_execution_authorized",
    "network_request_performed",
    "acquisition_performed",
    "source_approved",
    "source_enabled",
    "official_source_page",
    "advertised_download_hosts",
    "readiness_evidence_ref",
    "proposed_observations",
    "execution_constraints",
    "required_provenance_fields",
    "unresolved_execution_controls",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "proposal_version": {"const": "1.0.0"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "jurisdiction": {"const": "CA"},
    "proposal_status": {"const": "PROPOSAL_ONLY_NOT_AUTHORIZED"},
    "created_at": {"type": "string", "format": "date-time"},
    "network_execution_authorized": {"const": false},
    "network_request_performed": {"const": false},
    "acquisition_performed": {"const": false},
    "source_approved": {"const": false},
    "source_enabled": {"const": false},
    "official_source_page": {"type": "string", "format": "uri"},
    "advertised_download_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}
    },
    "readiness_evidence_ref": {"type": "string", "minLength": 1},
    "proposed_observations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "EXACT_ENDPOINT_IDENTITY",
          "REDIRECT_CHAIN",
          "HTTP_STATUS",
          "FINAL_HOST",
          "RESPONSE_HEADERS",
          "CONTENT_TYPE",
          "CONTENT_LENGTH",
          "TLS_SCHEME",
          "OBSERVED_AT"
        ]
      }
    },
    "execution_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "https_only",
        "execution_approval_required",
        "execution_approval_ref",
        "request_method",
        "timeout_seconds",
        "max_redirects",
        "allowlisted_hosts",
        "response_body_bytes_allowed",
        "persist_response_body",
        "parse_response_body",
        "persist_dataset_artifact",
        "pii_processing_allowed",
        "beneficiary_matching_allowed",
        "outreach_allowed"
      ],
      "properties": {
        "https_only": {"const": true},
        "execution_approval_required": {"const": true},
        "execution_approval_ref": {"const": null},
        "request_method": {"const": null},
        "timeout_seconds": {"const": null},
        "max_redirects": {"const": null},
        "allowlisted_hosts": {"type": "array", "maxItems": 0},
        "response_body_bytes_allowed": {"const": 0},
        "persist_response_body": {"const": false},
        "parse_response_body": {"const": false},
        "persist_dataset_artifact": {"const": false},
        "pii_processing_allowed": {"const": false},
        "beneficiary_matching_allowed": {"const": false},
        "outreach_allowed": {"const": false}
      }
    },
    "required_provenance_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "SOURCE_ID",
          "OBSERVED_AT",
          "REQUESTED_ENDPOINT",
          "FINAL_ENDPOINT",
          "REDIRECT_HOPS",
          "HTTP_STATUS",
          "RESPONSE_HEADERS",
          "EXECUTION_APPROVAL_REF"
        ]
      }
    },
    "unresolved_execution_controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "EXACT_ENDPOINT",
          "REQUEST_METHOD",
          "TIMEOUT_SECONDS",
          "MAX_REDIRECTS",
          "ALLOWLISTED_HOSTS",
          "EXECUTION_APPROVAL_REF",
          "OBSERVED_CONTENT_TYPE",
          "OBSERVED_CONTENT_LENGTH"
        ]
      }
    },
    "notes": {"type": "string", "minLength": 1}
  }
}
