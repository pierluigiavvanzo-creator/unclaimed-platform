        "transient_data_rows_max": {"const": 4},
        "stop_at_first_reproduced_format_mismatch": {"const": true},
        "head_requests_max": {"const": 1},
        "range_requests_max": {"const": 1},
        "http_requests_max_total": {"const": 2},
        "range_response_bytes_max_each": {"const": 131072},
