    ]},
    "implementation_state": {
      "const": {
        "source_request_performed": false,
        "diagnostic_execution_performed": false,
        "network_workflow_created": false,
        "runner_modified": false,
        "parser_modified": false,
        "regex_modified": false,
        "normalization_modified": false,
        "logging_modified": false,
        "persistence_modified": false
      }
    },
    "safety_state": {
      "const": {
        "source_policy_status": "PROPOSED",
        "registry_enabled": false,
        "registry_approved_for_use": false,
        "approved_real_sources": 0,
        "semantic_compatibility_resolved": false,
        "production_classification_active": false,
        "downstream_gates_remain_closed": true
      }
    },
    "next_gate": {"const": "HUMAN_PROPERTY_TYPE_DIAGNOSTIC_EXECUTION_AUTHORIZATION_REVIEW"},
    "next_gate_after_both_fresh_approvals": {"const": "ONE_SHOT_PROPERTY_TYPE_DIAGNOSTIC_EXECUTION"},
