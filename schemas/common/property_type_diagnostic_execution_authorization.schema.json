    "classifier_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_regex", "classification_precedence", "surrounding_ascii_whitespace_codepoints",
        "ascii_uppercase_mapping", "non_ascii_definition", "disallowed_ascii_control_codepoints",
        "precedence_note", "runtime_transform_acceptance_allowed", "remediation_during_diagnostic_allowed"
      ],
      "properties": {
        "current_regex": {"const": "^(?:[A-Z]{2}[0-9]{2}|ZZZZ)$"},
        "classification_precedence": {"const": [
          "SURROUNDING_ASCII_WHITESPACE_ONLY",
          "ASCII_CASE_ONLY",
          "SURROUNDING_ASCII_WHITESPACE_AND_CASE",
          "NON_ASCII_OR_CONTROL_CONTENT",
          "ASCII_STRUCTURAL_MISMATCH"
        ]},
        "surrounding_ascii_whitespace_codepoints": {"const": ["U+0020", "U+0009"]},
        "ascii_uppercase_mapping": {
          "const": {
            "input_range": "U+0061-U+007A",
            "output_range": "U+0041-U+005A",
            "offset": -32,
            "all_other_codepoints_unchanged": true,
            "locale_sensitive_behavior_allowed": false,
            "unicode_normalization_allowed": false
          }
        },
        "non_ascii_definition": {"const": "ANY_CODEPOINT_GREATER_THAN_U+007F"},
        "disallowed_ascii_control_codepoints": {"const": [
          "U+0000", "U+0001", "U+0002", "U+0003", "U+0004", "U+0005", "U+0006", "U+0007",
          "U+0008", "U+0009", "U+000A", "U+000B", "U+000C", "U+000D", "U+000E", "U+000F",
          "U+0010", "U+0011", "U+0012", "U+0013", "U+0014", "U+0015", "U+0016", "U+0017",
          "U+0018", "U+0019", "U+001A", "U+001B", "U+001C", "U+001D", "U+001E", "U+001F",
          "U+007F"
        ]},
        "precedence_note": {"type": "string", "minLength": 1},
        "runtime_transform_acceptance_allowed": {"const": false},
        "remediation_during_diagnostic_allowed": {"const": false}
      }
    },
    "diagnostic_classes": {"const": [
      "SURROUNDING_ASCII_WHITESPACE_ONLY",
      "ASCII_CASE_ONLY",
      "SURROUNDING_ASCII_WHITESPACE_AND_CASE",
      "NON_ASCII_OR_CONTROL_CONTENT",
      "ASCII_STRUCTURAL_MISMATCH"
    ]},
    "fail_closed_reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_result_status_values", "diagnostic_class_when_classified",
        "diagnostic_class_when_stopped_fail_closed", "fail_closed_reason_code_when_classified",
        "fail_closed_reason_code_when_stopped_fail_closed", "allowed_persisted_fields",
        "source_derived_free_text_allowed", "exact_property_type_allowed", "property_type_bytes_allowed",
