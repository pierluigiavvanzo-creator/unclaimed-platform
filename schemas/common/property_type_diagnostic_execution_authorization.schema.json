        "expected_accept_ranges", "canonical_member", "canonical_member_local_header_offset",
        "members_max", "transient_data_rows_max", "stop_at_first_reproduced_format_mismatch",
        "head_requests_max", "range_requests_max", "http_requests_max_total",
