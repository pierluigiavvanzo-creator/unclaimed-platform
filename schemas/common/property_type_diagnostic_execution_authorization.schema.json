        "diagnostic_class_when_stopped_fail_closed": {"type": "null"},
        "fail_closed_reason_code_when_classified": {"type": "null"},
        "fail_closed_reason_code_when_stopped_fail_closed": {"const": "REQUIRED_ONE_OF_FAIL_CLOSED_REASON_CODES"},
        "allowed_persisted_fields": {"const": [
          "diagnostic_result_status", "diagnostic_class", "fail_closed_reason_code", "source_identity_verified",
          "head_requests", "range_requests", "http_requests_total", "source_response_body_bytes_read",
          "transient_rows_examined", "safety_flags"
        ]},
        "source_derived_free_text_allowed": {"const": false},
        "exact_property_type_allowed": {"const": false},
        "property_type_bytes_allowed": {"const": false},
        "property_type_hash_allowed": {"const": false},
        "property_type_exact_length_allowed": {"const": false},
        "property_type_fragments_allowed": {"const": false},
        "property_type_codepoints_allowed": {"const": false},
        "transformed_property_type_allowed": {"const": false},
        "full_row_allowed": {"const": false},
        "raw_response_body_allowed": {"const": false},
        "property_id_allowed": {"const": false},
        "owner_holder_values_allowed": {"const": false},
        "distinct_property_type_codes_allowed": {"const": false}
      }
    },
    "synthetic_classifier_vectors": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "expected_class"],
        "properties": {
          "input": {"type": "string"},
          "expected_class": {"enum": [
            "SURROUNDING_ASCII_WHITESPACE_ONLY",
            "ASCII_CASE_ONLY",
            "SURROUNDING_ASCII_WHITESPACE_AND_CASE",
            "NON_ASCII_OR_CONTROL_CONTENT",
            "ASCII_STRUCTURAL_MISMATCH"
