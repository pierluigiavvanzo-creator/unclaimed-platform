        "human_labor_cost_cents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Labor Cost Cents"
        },
        "fully_loaded_follow_up_cost_state": {
          "enum": [
            "NOT_COMPUTABLE_NO_LABOR_RATE",
