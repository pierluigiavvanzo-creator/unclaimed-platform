        },
        "human_review_seconds": {
          "minimum": 0,
          "title": "Human Review Seconds",
          "type": "integer"
        },
        "manual_research_seconds": {
          "minimum": 0,
          "title": "Manual Research Seconds",
          "type": "integer"
