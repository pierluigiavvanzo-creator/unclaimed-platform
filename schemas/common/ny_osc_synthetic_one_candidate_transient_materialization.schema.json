          "type": "string"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "automated_processing_cost_cents": {
          "minimum": 0,
          "title": "Automated Processing Cost Cents",
          "type": "integer"
        },
        "source_data_cost_cents": {
          "minimum": 0,
          "title": "Source Data Cost Cents",
