        },
        "fully_loaded_follow_up_cost_cents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fully Loaded Follow Up Cost Cents"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
