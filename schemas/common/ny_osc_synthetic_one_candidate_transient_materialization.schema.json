          "minItems": 4,
          "title": "Evidence Refs",
          "type": "array"
        },
        "owner_pii_included": {
          "const": false,
          "title": "Owner Pii Included",
          "type": "boolean"
        },
        "no_commercial_recommendation": {
          "const": true,
          "title": "No Commercial Recommendation",
          "type": "boolean"
        }
      },
      "required": [
        "measurement_id",
        "candidate_case_id",
        "automated_processing_cost_cents",
        "source_data_cost_cents",
        "direct_machine_and_data_cost_cents",
        "human_review_seconds",
        "manual_research_seconds",
        "total_human_seconds",
        "human_labor_rate_state",
        "human_labor_cost_state",
