{
  "$defs": {
    "EconomicCaseLedger": {
      "additionalProperties": false,
      "description": "Non-PII economics evidence record for the synthetic one-case experiment.",
      "properties": {
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "mode": {
          "const": "SYNTHETIC_TEST_ONLY",
          "default": "SYNTHETIC_TEST_ONLY",
          "title": "Mode",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "source_id": {
          "const": "ny.osc.unclaimed_funds.owner_name_file",
          "default": "ny.osc.unclaimed_funds.owner_name_file",
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_ref": {
          "minLength": 1,
          "title": "Source Snapshot Ref",
          "type": "string"
        },
        "selection_rule_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Selection Rule Version",
          "type": "string"
        },
        "source_record_ordinal": {
          "minimum": 1,
          "title": "Source Record Ordinal",
          "type": "integer"
        },
        "lane": {
          "$ref": "#/$defs/FrictionLaneAssignment"
        },
        "stage_events": {
          "items": {
            "$ref": "#/$defs/EconomicStageEvent"
          },
          "minItems": 2,
          "title": "Stage Events",
          "type": "array"
        },
        "current_discovery_stage": {
          "const": "L1",
          "default": "L1",
          "title": "Current Discovery Stage",
          "type": "string"
        },
        "pre_value_discovery_cost": {
          "$ref": "#/$defs/PreValueDiscoveryCostSummary"
        },
        "value_evidence_state": {
          "const": "UNKNOWN_PRE_CLAIM_REVIEW",
          "default": "UNKNOWN_PRE_CLAIM_REVIEW",
          "title": "Value Evidence State",
          "type": "string"
        },
        "value_evidence_ref": {
          "const": "component:ny_mvp1_precontact_economics_evidence",
          "default": "component:ny_mvp1_precontact_economics_evidence",
          "title": "Value Evidence Ref",
          "type": "string"
        },
        "candidate_selected": {
          "const": true,
          "default": true,
          "title": "Candidate Selected",
          "type": "boolean"
        },
        "identity_work_started": {
          "const": false,
          "default": false,
          "title": "Identity Work Started",
          "type": "boolean"
        },
        "contactability_established": {
          "const": false,
          "default": false,
          "title": "Contactability Established",
          "type": "boolean"
        },
        "contact_attempts_count": {
          "const": 0,
          "default": 0,
          "title": "Contact Attempts Count",
          "type": "integer"
        },
        "agreement_offered": {
          "const": false,
          "default": false,
          "title": "Agreement Offered",
          "type": "boolean"
        },
        "agreement_signed": {
          "const": false,
          "default": false,
          "title": "Agreement Signed",
          "type": "boolean"
        },
        "claim_recovery_started": {
          "const": false,
          "default": false,
          "title": "Claim Recovery Started",
          "type": "boolean"
        },
        "recovery_success": {
          "const": false,
          "default": false,
          "title": "Recovery Success",
          "type": "boolean"
        },
        "fee_billed_cents": {
          "default": null,
          "title": "Fee Billed Cents",
          "type": "null"
        },
        "fee_collected_cents": {
          "default": null,
          "title": "Fee Collected Cents",
          "type": "null"
        },
        "integration_hooks": {
          "$ref": "#/$defs/EconomicIntegrationHooks"
        },
        "owner_pii_included": {
          "const": false,
          "default": false,
          "title": "Owner Pii Included",
          "type": "boolean"
        },
        "no_lane_value_prediction": {
          "const": true,
          "default": true,
          "title": "No Lane Value Prediction",
          "type": "boolean"
        },
        "no_commercial_recommendation": {
          "const": true,
          "default": true,
          "title": "No Commercial Recommendation",
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "source_snapshot_ref",
        "source_record_ordinal",
        "lane",
        "stage_events",
        "pre_value_discovery_cost",
        "integration_hooks"
      ],
      "title": "EconomicCaseLedger",
      "type": "object"
    },
    "EconomicIntegrationHooks": {
      "additionalProperties": false,
      "properties": {
        "value_evidence_component": {
          "const": "unclaimed_platform.domain.ny_mvp1_value_evidence.ny_mvp1_precontact_economics_evidence",
          "default": "unclaimed_platform.domain.ny_mvp1_value_evidence.ny_mvp1_precontact_economics_evidence",
          "title": "Value Evidence Component",
          "type": "string"
        },
        "follow_up_cost_component": {
          "const": "unclaimed_platform.domain.ny_mvp1_follow_up_cost.measure_follow_up_cost",
          "default": "unclaimed_platform.domain.ny_mvp1_follow_up_cost.measure_follow_up_cost",
          "title": "Follow Up Cost Component",
          "type": "string"
        },
        "case_economics_component": {
          "const": "unclaimed_platform.domain.ny_mvp1_case_economics_integration.integrate_follow_up_cost_with_case_economics",
          "default": "unclaimed_platform.domain.ny_mvp1_case_economics_integration.integrate_follow_up_cost_with_case_economics",
          "title": "Case Economics Component",
          "type": "string"
        },
        "case_economics_integration_state": {
          "const": "BLOCKED_VALUE_AND_FEE_EVIDENCE_REQUIRED",
          "default": "BLOCKED_VALUE_AND_FEE_EVIDENCE_REQUIRED",
          "title": "Case Economics Integration State",
          "type": "string"
        },
        "explicit_case_economics_computed": {
          "const": false,
          "default": false,
          "title": "Explicit Case Economics Computed",
          "type": "boolean"
        }
      },
      "title": "EconomicIntegrationHooks",
      "type": "object"
    },
    "EconomicStageEvent": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ],
          "title": "Stage",
          "type": "string"
        },
        "event": {
          "enum": [
            "ENTERED",
            "COMPLETED"
          ],
          "title": "Event",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "title": "Evidence Ref",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "event",
        "occurred_at",
        "evidence_ref"
      ],
      "title": "EconomicStageEvent",
      "type": "object"
    },
    "FrictionLaneAssignment": {
      "additionalProperties": false,
      "properties": {
        "initial_lane": {
          "enum": [
            "F0",
            "F1",
            "F2",
            "F3"
          ],
          "title": "Initial Lane",
          "type": "string"
        },
        "current_lane": {
          "enum": [
            "F0",
            "F1",
            "F2",
            "F3"
          ],
          "title": "Current Lane",
          "type": "string"
        },
        "assignment_basis": {
          "const": "EXPLICIT_SYNTHETIC_FRICTION_FIXTURE_NOT_VALUE_PREDICTION",
          "default": "EXPLICIT_SYNTHETIC_FRICTION_FIXTURE_NOT_VALUE_PREDICTION",
          "title": "Assignment Basis",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "lane_change_events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LaneChangeEvent"
          },
          "title": "Lane Change Events",
          "type": "array"
        },
        "value_prediction_performed": {
          "const": false,
          "default": false,
          "title": "Value Prediction Performed",
          "type": "boolean"
        }
      },
      "required": [
        "initial_lane",
        "current_lane",
        "evidence_refs"
      ],
      "title": "FrictionLaneAssignment",
      "type": "object"
    },
    "LaneChangeEvent": {
      "additionalProperties": false,
      "properties": {
        "from_lane": {
          "enum": [
            "F0",
            "F1",
            "F2",
            "F3"
          ],
          "title": "From Lane",
          "type": "string"
        },
        "to_lane": {
          "enum": [
            "F0",
            "F1",
            "F2",
            "F3"
          ],
          "title": "To Lane",
          "type": "string"
        },
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        },
        "reason_code": {
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "value_evidence_used": {
          "const": false,
          "default": false,
          "title": "Value Evidence Used",
          "type": "boolean"
        }
      },
      "required": [
        "from_lane",
        "to_lane",
        "changed_at",
        "reason_code",
        "evidence_refs"
      ],
      "title": "LaneChangeEvent",
      "type": "object"
    },
    "NyMvp1FollowUpCostMeasurementResult": {
