{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unclaimed-platform:schema:ny-osc-third-attempt-authorization-proposal:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_version",
    "prepared_on",
    "status",
    "source_id",
    "request_scope",
    "preceding_attempt",
    "verified_offline_remediation",
    "fresh_preflight",
    "proposed_execution_bounds",
    "proposed_privacy_scope",
    "required_human_authorizations",
    "implementation_gate",
    "authorization_does_not_grant",
    "next_action"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"const": "ny.osc.owner_name_file.third_bounded_attempt_authorization_proposal"},
    "artifact_version": {"const": "1.0.0"},
    "prepared_on": {"type": "string", "format": "date"},
    "status": {"const": "PROPOSED_NOT_AUTHORIZED"},
    "source_id": {"const": "ny.osc.unclaimed_funds.owner_name_file"},
    "request_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_only", "source_network_access_performed", "download_performed", "owner_file_opened", "owner_pii_processed"],
      "properties": {
        "repository_only": {"const": true},
        "source_network_access_performed": {"const": false},
        "download_performed": {"const": false},
        "owner_file_opened": {"const": false},
        "owner_pii_processed": {"const": false}
      }
    },
    "preceding_attempt": {"type": "object"},
    "verified_offline_remediation": {"type": "object"},
    "fresh_preflight": {
      "type": "object",
      "required": ["required_immediately_before_execution", "performed_for_this_proposal", "remote_access_authorized_by_this_proposal", "drift_behavior"],
      "properties": {
        "required_immediately_before_execution": {"const": true},
        "performed_for_this_proposal": {"const": false},
        "remote_access_authorized_by_this_proposal": {"const": false},
        "drift_behavior": {"const": "STOP_BEFORE_DOWNLOAD_AND_REFRESH_PROPOSAL"}
      }
    },
    "proposed_execution_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_number", "downloads_max", "retries_max", "max_download_bytes", "max_uncompressed_bytes", "max_archive_members", "text_members_required_exactly", "expected_delimiter", "expected_documented_field_count", "automatic_widening_allowed", "automatic_retry_allowed"],
      "properties": {
        "attempt_number": {"const": 3},
        "downloads_max": {"const": 1},
        "retries_max": {"const": 0},
        "max_download_bytes": {"const": 450000000},
        "max_uncompressed_bytes": {"const": 2000000000},
        "max_archive_members": {"const": 1},
        "text_members_required_exactly": {"const": 1},
        "expected_delimiter": {"const": "|"},
        "expected_documented_field_count": {"const": 14},
        "automatic_widening_allowed": {"const": false},
        "automatic_retry_allowed": {"const": false}
      }
    },
    "proposed_privacy_scope": {"type": "object"},
    "required_human_authorizations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["gate", "approval_phrase", "status", "single_use", "reusable"],
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "approval_phrase": {"type": "string", "minLength": 1},
          "status": {"const": "NOT_GRANTED"},
          "single_use": {"const": true},
          "reusable": {"const": false}
        }
      }
    },
    "implementation_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["third_attempt_runner_status", "third_attempt_approval_artifacts_status", "execution_status", "second_attempt_runner_reuse_allowed", "second_attempt_approval_reuse_allowed"],
      "properties": {
        "third_attempt_runner_status": {"const": "NOT_IMPLEMENTED"},
        "third_attempt_approval_artifacts_status": {"const": "NOT_CREATED"},
        "execution_status": {"const": "BLOCKED_PENDING_SEPARATE_HUMAN_AUTHORIZATION"},
        "second_attempt_runner_reuse_allowed": {"const": false},
        "second_attempt_approval_reuse_allowed": {"const": false}
      }
    },
    "authorization_does_not_grant": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"const": false}
    },
    "next_action": {"const": "HUMAN_REVIEW_NY_OSC_THIRD_BOUNDED_ATTEMPT_PROPOSAL"}
  }
}
