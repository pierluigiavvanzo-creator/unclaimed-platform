{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unclaimed-platform:schema:ny-mvp1-p1-fresh-listing-preflight-receipt:1.0.0",
  "title": "NY MVP1 P1 Fresh Listing Preflight Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "receipt_ref",
    "status",
    "source_id",
    "performed_at_utc",
    "freshness_window_seconds",
    "remote_name",
    "remote_size_display",
    "remote_last_modified_display",
    "remote_preflight_performed",
    "download_performed",
    "owner_file_opened",
    "owner_pii_processed",
    "contains_owner_pii",
    "source_snapshot_ref",
    "runner_checkpoint",
    "preflight_authorization_ref"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"const": "ny.mvp1.p1.fresh_listing_preflight_receipt"},
    "receipt_ref": {"type": "string", "minLength": 1},
    "status": {"const": "EXACT_MATCH"},
    "source_id": {"const": "ny.osc.unclaimed_funds.owner_name_file"},
    "performed_at_utc": {"type": "string", "format": "date-time"},
    "freshness_window_seconds": {"const": 900},
    "remote_name": {"enum": ["FINDERS.zip", "FINDERS.ZIP", "NYSFINDERS.ZIP"]},
    "remote_size_display": {"type": "string", "minLength": 1},
    "remote_last_modified_display": {"type": "string", "minLength": 1},
    "remote_preflight_performed": {"const": true},
    "download_performed": {"const": false},
    "owner_file_opened": {"const": false},
    "owner_pii_processed": {"const": false},
    "contains_owner_pii": {"const": false},
    "source_snapshot_ref": {"type": "string", "minLength": 1},
    "runner_checkpoint": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "preflight_authorization_ref": {"type": "string", "minLength": 1}
  }
}
