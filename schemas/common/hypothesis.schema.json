{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unclaimed-platform:schema:hypothesis:1.0.0",
  "title": "Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","hypothesis_id","case_id","hypothesis_type","statement","status","created_at","supporting_evidence_ids","contradicting_evidence_ids"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "hypothesis_id": {"type": "string", "format": "uuid"},
    "case_id": {"type": "string", "format": "uuid"},
    "hypothesis_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "statement": {"type": "string", "minLength": 1},
    "status": {"enum": ["OPEN","SUPPORTED","CONTRADICTED","REJECTED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "supporting_evidence_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "contradicting_evidence_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true}
  }
}
